---
import { sections } from "../../config/sections";
const pathname = Astro.url.pathname;
---


<header class="navbar">
    <div class="navbar-inner">
        <a class="logo" href="/">
            <img src="/inverse_checker.png" alt="Accueil" />
        </a>

        <button class="menu-toggle">
            <span class="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </span>
            Menu
        </button>

        
        <nav>
            <div class="nav-content">
                {
                    sections
                        .filter(section => section.nav)
                        .map(section => (
                            <a
                                href={section.href}
                                class:list={{
                                    active: pathname.startsWith(section.href),
                                    "desktop-only": section.nav_mobile === false
                                }}
                            >
                                {section.title}
                            </a>
                        ))
                }
            </div>
        </nav>
    </div>
</header>


<script>
    const button = document.querySelector(".menu-toggle");
    const nav = document.querySelector("nav");
    const icon = document.querySelector(".icon");

    button?.addEventListener("click", () => {

        nav?.classList.toggle("open");
        button?.classList.toggle("open");

    });
</script>


<style>

/* ----------------------------------------
--------------- Sur ordinateur
----------------------------------------*/

/* Barre de navigation */

.navbar {
    padding: 0;
    background: white;
    border-radius: 0 0 10px 10px;
    width: 95%;
    margin: 0 auto;
}

.navbar-inner {
    color:black;
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 auto;
    padding: 0;
}


/* Gestion du logo */

.logo img{
    margin: 1rem 0 1rem 2rem ;
    max-width: 50px;
    height: auto;
    transition: transform var(--transispeed);
}

.logo img:hover {
    transform: rotate(-5deg) ;
}


/* Style des liens */

a {
    font-weight:600 ;
    color: var(--colback);
    transition: transform var(--transispeed);
}

a:hover {
    transform: scale(1.2);
}

nav {
    flex: 1;
    display: flex;
    justify-content: right;
    gap: 4rem;
    margin: 0 3rem 0 0;
}

nav a {
    position: relative;
    color: black;
    text-decoration: none;
    font-weight: 600;
    transition: transform var(--transispeed), color var(--transispeed);
}


nav a:hover {
    color: var(--tertiary);
}

nav a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -0.3rem;
    width: 100%;
    height: 2px;
    background: var(--tertiary);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--transispeed);
}

nav a:hover::after,
nav a.active::after {
    transform: scaleX(1);
}


/* Suppression du menu */

.menu-toggle {
    display: none;
}



/* ----------------------------------------
--------------- Sur téléphone
----------------------------------------*/


@media (max-width:720px){

/* Barre de navigation */

    .navbar-inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
    }


/* Bouton du menu */

    .menu-toggle{
        display:inline-flex;
        align-items:center;
        gap:.5rem;

        border:none;
        background:none;
        color:black;
        padding:0.5rem;

        cursor:pointer;

        font-size:1rem;
        font-weight:600;
        margin-right: 2rem;
    }


/* Animation du menu */

    nav {
        flex-basis: 100%;
        width: 100%;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.5s ease-in-out;
        margin-left: :auto;
    }

    nav.open {
        max-height: 500px;
    }

    .nav-content {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 1rem;

        background: white;
        border-radius: 10px;
        padding: 0 0 1rem 0;
        transform: translateX(1rem);
    }


/* Animation des icônes ☰ et ✕ */

    .hamburger {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .hamburger span {
        width: 18px;
        height: 2px;
        background: black;
        border-radius: 2px;
        transition: transform 0.3s ease, opacity 0.4s ease;
    }

    .menu-toggle.open .hamburger span:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
    }

    .menu-toggle.open .hamburger span:nth-child(2) {
        opacity: 0;
    }

    .menu-toggle.open .hamburger span:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
    }  

}

</style>
