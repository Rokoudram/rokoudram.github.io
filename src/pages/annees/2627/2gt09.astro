---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="2GT09">


<div id="liste-pdf" , class = "grid">
    <script is:inline>
      fetch("https://rokoudram.github.io/LaTeX/2nd_gt/annee_2627/index.json")
        .then(r => r.json())
        .then(pdfs => {
          document.getElementById("liste-pdf").innerHTML =
            pdfs.map(pdf =>
              `<a class="ligne" href="https://rokoudram.github.io/LaTeX/2nd_gt/annee_2627/${pdf}" target="_blank">${pdf}</a>`
            ).join("");
        });
    </script>
</div>


</BaseLayout>


<style>

:global(.ligne) {
    font-size: 0.75rem;

    max-width: 350px;
    height:40px;
    padding: 3px;

    border: 3px solid var(--secondary);
    border-radius: 5px;
}

:global(.grid) {
    display: grid;
    justify-content: center;
    grid-template-columns: repeat(auto-fit, minmax(220px, 240px));
    column-gap : 1rem ;
    row-gap: 10px ;
}

</style>