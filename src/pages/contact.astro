---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact">

	<div class="intro">
		<h2>Me contacter</h2>
		<p>
			Pour me contacter, veuillez remplir le formulaire de contact ci-contre. <br>
			Si vous voulez me signaler un bug ou une erreur d'énoncé, merci d'être le plus précis possible dans vos explications !
		</p>
	</div>

	<form class="contact-form" action="https://api.web3forms.com/submit" method="POST">

		<input type="hidden" name="access_key" value="da2cbf7f-9551-4fdd-9e1b-b55507f0e21b">

		<input
			type="hidden"
			name="_next"
			value="https://rokoudram.github.io"
		>

		<select id="sujet" name="sujet">
			<option value="neutral" disabled selected>
				Choisissez un sujet ...
			</option>

			<option value="bug">
				Bug
			</option>

			<option value="erreur">
				Erreur d'énoncé
			</option>

			<option value="suggestion">
				Suggestion
			</option>

			<option value="perso">
				Me contacter personnellement
			</option>

			<option value="autre">
				Autre
			</option>
		</select>

		<input 
			id="email"
			type="email"
			name="email"
			required
			placeholder="Entrez votre adresse e-mail"
		>

		<textarea
			id="message"
			name="message"
			rows="8"
			placeholder="Écrivez votre message ici ..."
		></textarea>

		<button type="submit">Envoyer</button>

	</form>

</BaseLayout>



<style>

	/* Généralités */
	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		align-items: center;
	}

	/* Zone de texte */
	.contact-form textarea {
		width: 80%;
		padding: 0.5rem;

		min-height: 100px;
		min-width: 300px;
		resize:vertical;

		border: 3px solid var(--secondary);
  		border-radius: 10px;
	}

	.contact-form textarea:focus {
		border-color: var(--tertiary);
		outline: none ;
	}

	/* Bouton "envoyer" */
	.contact-form button {
		background-color: var(--secondary);
		color: white;
		border: 1px solid white;

		padding: 0.5rem;
		border-radius: 5px;
		font-size: 0.7rem;

		cursor: pointer;
		align-self: center;
	}

	.contact-form button:hover{
		background-color: var(--tertiary);
	}

	/* Liste déroulante */
	.contact-form select {
		width: 79%;
		padding: 0.5rem ;
		border: 2px solid var(--secondary);
		border-radius: 5px;
		font-size: 0.7rem;
		background-color: white;
		cursor: pointer;
	}

	.contact-form select:focus {
		border-color: var(--tertiary);
		outline: none;
	}

	/* Zone pour l'adresse mail */
	.contact-form input {
		width: 79%;
		padding: 0.5rem ;
		border: 2px solid var(--secondary);
		border-radius: 5px;
		font-size: 0.7rem;
		background-color: white;
		cursor: pointer;
	}

	.contact-form input:focus {
		border-color: var(--tertiary);
		outline: none;
	}

	/* Intro */
	.intro{
		font-size: 0.85rem;
	}

</style>