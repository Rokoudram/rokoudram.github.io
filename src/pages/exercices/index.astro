---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { listeExercices } from '../../../config/liste-exercices';
---

<BaseLayout title="Exercices">

    <section class="intro">
        <p>
            Page d'accueil des exercices
        </p>
    </section>


    
<div class="grid">
    {listeExercices.map((niveau) => (
        <div class="zoom">
            <a class="card" href={niveau.href}>
                <h2>{niveau.titre}</h2>
                <p>{niveau.description}</p>
                <span>Découvrir →</span>
            </a>
        </div>
    ))}
</div>


</BaseLayout>


<style>
.intro {
    min-width: 50px;
    max-width: 800px;
    font-size: 1.2rem;
}

.intro p {
    margin-bottom: 1.5rem;
}



</style>